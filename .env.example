# PostgreSQL（生产环境由 Docker Compose 注入）
DATABASE_URL=postgres://creator:change-me@db:5432/creator_os
NEXT_PUBLIC_APP_URL=http://your-server-ip
POSTGRES_DB=creator_os
POSTGRES_USER=creator
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ForgeOps 下发的默认运行资源；生产流水线会用固定资源档位覆盖这些值
MEDIA_BIND_ADDRESS=0.0.0.0
MEDIA_HOST_PORT=8080
MEDIA_APP_CPU=2.0
MEDIA_APP_MEMORY=2g
MEDIA_DATABASE_CPU=1.0
MEDIA_DATABASE_MEMORY=1g

# 可选：按需配置商用模型 API
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
